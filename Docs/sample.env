# ==============================================================================
# Resume-Saathi — Consolidated Environment & Secrets Reference
# Safe for public repositories (all values are sanitized placeholders).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE (.env or backend.env)
# ------------------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# Base URLs
HOST_SERVER=https://resumesaathi.tusharsaini.tech
FRONTEND_URL=https://resumesaathi.tusharsaini.tech
CLIENT_URLS=https://resumesaathi.tusharsaini.tech,https://www.resumesaathi.tusharsaini.tech

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/ResumeSaathiDB?retryWrites=true&w=majority
MONGODB_URI_FALLBACK=mongodb://<db_user>:<db_password>@ac-xxxxx-shard-00-00.mongodb.net:27017/ResumeSaathiDB?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin

# Authentication
JWT_SECRET_KEY=your_random_jwt_secret_32_characters_minimum

# Mail Service (AWS SES / SMTP)
MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_aws_ses_smtp_username
MAIL_PASS=your_aws_ses_smtp_password
MAIL_FROM=support@resumesaathi.tusharsaini.tech

# Cloudinary (Media & PDF storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Models (Google Gemini)
GEMINI_API_KEYS=gemini_api_key_1,gemini_api_key_2
GEMINI_MODEL=gemini-2.5-flash

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# IP Geolocation
IPWHO_API_KEY=your_ipwhois_api_key


# ------------------------------------------------------------------------------
# 2. FRONTEND SERVICE (.env or frontend.env)
# ------------------------------------------------------------------------------
VITE_SERVER_URL=https://resumesaathi.tusharsaini.tech/api/v1


# ------------------------------------------------------------------------------
# 3. GITHUB ACTIONS SECRETS (Repository Settings -> Secrets and variables -> Actions)
# ------------------------------------------------------------------------------
# DOCKER_USERNAME        : Your Docker Hub username (e.g. tusharsaini999)
# DOCKER_ACCESS_TOKEN    : Docker Hub Personal Access Token (PAT) with Read/Write permissions
# AWS_ACCESS_KEY_ID      : IAM User Access Key with SSM SendCommand permissions
# AWS_SECRET_ACCESS_KEY  : IAM User Secret Access Key
# AWS_REGION             : AWS Region of your EC2 instance (e.g. ap-south-1)
# AWS_INSTANCE_ID        : EC2 Instance ID (e.g. i-0123456789abcdef0)
