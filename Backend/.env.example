# ==============================================================================
# Resume-Saathi Backend — Environment Variables Template
# Copy this file to .env and replace the placeholder values with your credentials.
# NOTE: DO NOT COMMIT REAL SECRETS OR SENSITIVE PASSWORDS TO GIT.
# ==============================================================================

# ─── Server Configuration ─────────────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# ─── Domains & CORS ───────────────────────────────────────────────────────────
# HOST_SERVER: Public-facing base domain used for OAuth redirect callbacks
HOST_SERVER=https://resumesaathi.tusharsaini.tech

# FRONTEND_URL: URL of your client app
FRONTEND_URL=https://resumesaathi.tusharsaini.tech

# CLIENT_URLS: Comma-separated list of allowed CORS origins
CLIENT_URLS=https://resumesaathi.tusharsaini.tech,https://www.resumesaathi.tusharsaini.tech

# ─── MongoDB Database ─────────────────────────────────────────────────────────
# Primary MongoDB Atlas Connection String (SRV)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ResumeSaathiDB?retryWrites=true&w=majority

# Optional Fallback Connection String (Direct Replica Set URL)
MONGODB_URI_FALLBACK=mongodb://<username>:<password>@ac-xxxxx-shard-00-00.mongodb.net:27017,ac-xxxxx-shard-00-01.mongodb.net:27017/ResumeSaathiDB?ssl=true&replicaSet=atlas-xxxxx-shard-0&authSource=admin

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET_KEY=your_super_secret_jwt_random_key_min_32_chars

# ─── Email Service (AWS SES / SMTP) ───────────────────────────────────────────
MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_smtp_username
MAIL_PASS=your_smtp_password
MAIL_FROM=support@resumesaathi.tusharsaini.tech

# ─── Cloudinary (File & Resume Storage) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# Comma-separated Gemini API keys for round-robin rotation and load management
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Google OAuth 2.0 ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ─── LinkedIn OAuth 2.0 ───────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ─── IP Geolocation / Lookup ──────────────────────────────────────────────────
IPWHO_API_KEY=your_ipwhois_api_key
