NODE_ENV=development
HOST=localhost
PORT=5000
HOST_SERVER=https://api.resumesaathi.tusharsaini.tech
FRONTEND_URL=https://resumesaathi.tusharsaini.tech

# Comma-separated CORS origins
CLIENT_URLS=http://localhost:5173,https://resumesaathi.tusharsaini.tech

# MongoDB base URI (DB name is appended in code)
MONGODB_URI=mongodb://localhost:27017

JWT_SECRET_KEY=replace_with_a_strong_secret
GEMINI_API_KEYS=replace_with_gemini_key_1,replace_with_gemini_key_2
GEMINI_MODEL=gemini-3.1-flash-lite

# OAuth
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
LINKEDIN_CLIENT_ID=replace_with_linkedin_client_id
LINKEDIN_CLIENT_SECRET=replace_with_linkedin_client_secret

# Email transport
MAIL_HOST=smtp.zoho.in
MAIL_PORT=465
MAIL_SECURE=true # Set to true for port 465 (SSL), false for port 587/25 (STARTTLS)
MAIL_USER=you@example.com # SMTP username / AWS SES IAM Access Key ID
MAIL_PASS=replace_with_mail_app_password # SMTP password / AWS SES Secret Access Key
MAIL_FROM="support@resumesaathi.tusharsaini.tech" # Sender email address (verified in AWS SES / SMTP provider)

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# IP lookup service
IPWHO_API_KEY=replace_with_ipwho_key