NODE_ENV=development
HOST=localhost
PORT=5000
HOST_SERVER=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Comma-separated CORS origins
CLIENT_URLS=http://localhost:5173

# MongoDB base URI (DB name is appended in code)
MONGODB_URI=mongodb://localhost:27017

JWT_SECRET_KEY=replace_with_a_strong_secret
GROQ_API_KEY=replace_with_groq_key

# OAuth
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
LINKEDIN_CLIENT_ID=replace_with_linkedin_client_id
LINKEDIN_CLIENT_SECRET=replace_with_linkedin_client_secret

# Email transport
MAIL_HOST=smtp.zoho.in
MAIL_PORT=465
MAIL_USER=you@example.com
MAIL_PASS=replace_with_mail_app_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret

# IP lookup service
IPWHO_API_KEY=replace_with_ipwho_key